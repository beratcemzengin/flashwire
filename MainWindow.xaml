<Window x:Class="FlashWire.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="FlashWire - High-Speed DPI &amp; DNS Shield" 
        Icon="app.ico"
        Height="570" Width="360"
        WindowStyle="None" 
        AllowsTransparency="True" 
        Background="Transparent"
        ResizeMode="NoResize"
        WindowStartupLocation="CenterScreen">

    <Window.Resources>
        <!-- Modern Rounded Action Button Style -->
        <Style x:Key="ActionButtonStyle" TargetType="Button">
            <Setter Property="Foreground" Value="#0B0D12"/>
            <Setter Property="FontWeight" Value="ExtraBold"/>
            <Setter Property="FontSize" Value="15"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="border" 
                                CornerRadius="25" 
                                Background="{TemplateBinding Background}"
                                BorderThickness="1"
                                BorderBrush="#40FFB800">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="border" Property="Opacity" Value="0.92"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="border" Property="Opacity" Value="0.82"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Window Control Button Style -->
        <Style x:Key="WindowBtnStyle" TargetType="Button">
            <Setter Property="Foreground" Value="#94A3B8"/>
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="btnBorder" Background="{TemplateBinding Background}" CornerRadius="14" Width="28" Height="28">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="btnBorder" Property="Background" Value="#1A2130"/>
                                <Setter Property="Foreground" Value="#F8FAFC"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- ComboBoxItem Style -->
        <Style x:Key="DarkComboBoxItemStyle" TargetType="ComboBoxItem">
            <Setter Property="Foreground" Value="#F8FAFC"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Padding" Value="12,8"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ComboBoxItem">
                        <Border x:Name="itemBorder" Background="Transparent" CornerRadius="8" Padding="{TemplateBinding Padding}" Margin="2,1">
                            <ContentPresenter HorizontalAlignment="Left" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="itemBorder" Property="Background" Value="#1C2333"/>
                                <Setter Property="Foreground" Value="#FFB800"/>
                            </Trigger>
                            <Trigger Property="IsSelected" Value="True">
                                <Setter TargetName="itemBorder" Property="Background" Value="#252A15"/>
                                <Setter Property="Foreground" Value="#FFB800"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- ComboBox ToggleButton Style -->
        <ControlTemplate x:Key="DarkComboBoxToggleButton" TargetType="ToggleButton">
            <Border x:Name="border" Background="#131620" BorderBrush="#242C3D" BorderThickness="1" CornerRadius="10">
                <Grid>
                    <Path x:Name="arrow" HorizontalAlignment="Right" VerticalAlignment="Center" Margin="0,0,12,0" 
                          Data="M 0 0 L 4 4 L 8 0 Z" Fill="#FFB800"/>
                </Grid>
            </Border>
            <ControlTemplate.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter TargetName="border" Property="BorderBrush" Value="#FFB800"/>
                </Trigger>
            </ControlTemplate.Triggers>
        </ControlTemplate>

        <!-- Complete Dark ComboBox Style -->
        <Style x:Key="DarkComboBoxStyle" TargetType="ComboBox">
            <Setter Property="Foreground" Value="#F8FAFC"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="ItemContainerStyle" Value="{StaticResource DarkComboBoxItemStyle}"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ComboBox">
                        <Grid>
                            <ToggleButton x:Name="toggleButton" 
                                          Template="{StaticResource DarkComboBoxToggleButton}" 
                                          Focusable="false" 
                                          IsChecked="{Binding Path=IsDropDownOpen, Mode=TwoWay, RelativeSource={RelativeSource TemplatedParent}}" 
                                          ClickMode="Press"/>
                            <ContentPresenter x:Name="contentPresenter" 
                                              IsHitTestVisible="false" 
                                              Content="{TemplateBinding SelectionBoxItem}" 
                                              ContentTemplate="{TemplateBinding SelectionBoxItemTemplate}" 
                                              ContentTemplateSelector="{TemplateBinding ItemTemplateSelector}" 
                                              Margin="12,0,28,0" 
                                              VerticalAlignment="Center" 
                                              HorizontalAlignment="Left"/>
                            <Popup x:Name="popup" 
                                   Placement="Bottom" 
                                   IsOpen="{TemplateBinding IsDropDownOpen}" 
                                   AllowsTransparency="True" 
                                   Focusable="False" 
                                   PopupAnimation="Slide">
                                <Border x:Name="dropdownBorder" 
                                        MinWidth="{TemplateBinding ActualWidth}" 
                                        MaxHeight="260" 
                                        Background="#131620" 
                                        BorderBrush="#242C3D" 
                                        BorderThickness="1.2" 
                                        CornerRadius="10" 
                                        Margin="0,4,0,0"
                                        Padding="4">
                                    <Border.Effect>
                                        <DropShadowEffect Color="#000000" BlurRadius="20" ShadowDepth="4" Opacity="0.85"/>
                                    </Border.Effect>
                                    <ScrollViewer SnapsToDevicePixels="True" VerticalScrollBarVisibility="Auto">
                                        <StackPanel IsItemsHost="True" KeyboardNavigation.DirectionalNavigation="Contained"/>
                                    </ScrollViewer>
                                </Border>
                            </Popup>
                        </Grid>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <!-- Main Container Card with Outer Shadow -->
    <Border Margin="10" CornerRadius="24" BorderThickness="1.2">
        <Border.BorderBrush>
            <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                <GradientStop Color="#2A3448" Offset="0"/>
                <GradientStop Color="#181E2C" Offset="1"/>
            </LinearGradientBrush>
        </Border.BorderBrush>
        
        <Border.Background>
            <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                <GradientStop Color="#0D1017" Offset="0.0"/>
                <GradientStop Color="#090B0F" Offset="1.0"/>
            </LinearGradientBrush>
        </Border.Background>
        
        <Border.Effect>
            <DropShadowEffect Color="#000000" BlurRadius="25" ShadowDepth="4" Opacity="0.8"/>
        </Border.Effect>

        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="50"/>   <!-- Header -->
                <RowDefinition Height="*"/>    <!-- Main Content -->
                <RowDefinition Height="Auto"/> <!-- Test Panel Drawer -->
                <RowDefinition Height="Auto"/> <!-- Bottom Info Bar -->
            </Grid.RowDefinitions>

            <!-- TOP HEADER (Draggable) -->
            <Border Grid.Row="0" Background="Transparent" MouseLeftButtonDown="Header_MouseLeftButtonDown">
                <Grid Margin="18,0,14,0">
                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                        <!-- FlashWire Lightning Logo -->
                        <Image Source="flashwire_gold.png" Width="24" Height="24" Margin="0,0,9,0" RenderOptions.BitmapScalingMode="HighQuality"/>
                        <TextBlock Text="FLASH" Foreground="#F8FAFC" FontWeight="ExtraBold" FontSize="14.5" VerticalAlignment="Center"/>
                        <TextBlock Text="WIRE" Foreground="#FFB800" FontWeight="ExtraBold" FontSize="14.5" VerticalAlignment="Center"/>
                        <Border Background="#1E2638" CornerRadius="6" Padding="5,1" Margin="8,0,0,0" VerticalAlignment="Center">
                            <TextBlock Text="v2.0" Foreground="#94A3B8" FontSize="9.5" FontWeight="Bold"/>
                        </Border>
                    </StackPanel>

                    <!-- Control Buttons -->
                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center">
                        <Button x:Name="btnHeaderTest" Style="{StaticResource WindowBtnStyle}" Content="🚀" Click="BtnHeaderTest_Click" ToolTip="Ağ &amp; Site Testi" Margin="0,0,4,0"/>
                        <Button x:Name="btnSettings" Style="{StaticResource WindowBtnStyle}" Content="⚙" Click="BtnSettings_Click" ToolTip="Operatör &amp; Ayarlar" Margin="0,0,4,0"/>
                        <Button x:Name="btnMinimize" Style="{StaticResource WindowBtnStyle}" Content="—" Click="BtnMinimize_Click" ToolTip="Simge Durumuna Küçült" Margin="0,0,4,0"/>
                        <Button x:Name="btnClose" Style="{StaticResource WindowBtnStyle}" Content="✕" Click="BtnClose_Click" ToolTip="Kapat"/>
                    </StackPanel>
                </Grid>
            </Border>

            <!-- CENTER MAIN CONTENT -->
            <StackPanel Grid.Row="1" VerticalAlignment="Center" HorizontalAlignment="Center" Margin="0,0,0,10">
                
                <!-- 1. Security Status Pill Badge -->
                <Border x:Name="badgeStatus" CornerRadius="16" Background="#161924" BorderBrush="#242D3F" BorderThickness="1" Padding="18,6" HorizontalAlignment="Center" Margin="0,0,0,18">
                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                        <Ellipse x:Name="dotStatus" Width="8" Height="8" Fill="#EF4444" Margin="0,0,8,0" VerticalAlignment="Center"/>
                        <TextBlock x:Name="txtStatus" Text="○ GÜVENLİK DEVRE DIŞI" Foreground="#EF4444" FontWeight="Bold" FontSize="11.5"/>
                    </StackPanel>
                </Border>

                <!-- 2. Circular Halo Display Orb -->
                <Grid Width="144" Height="144" HorizontalAlignment="Center" Margin="0,0,0,18">
                    <!-- Outer Halo Ring -->
                    <Ellipse x:Name="orbGlow" Width="142" Height="142">
                        <Ellipse.Fill>
                            <RadialGradientBrush>
                                <GradientStop Color="#00FFB800" Offset="0.6"/>
                                <GradientStop Color="#00FFB800" Offset="1"/>
                            </RadialGradientBrush>
                        </Ellipse.Fill>
                        <Ellipse.Effect>
                            <DropShadowEffect x:Name="orbDropShadow" Color="#EF4444" BlurRadius="24" ShadowDepth="0" Opacity="0.3"/>
                        </Ellipse.Effect>
                    </Ellipse>

                    <!-- Inner Circle Background -->
                    <Border x:Name="orbBorder" Width="122" Height="122" CornerRadius="61" BorderThickness="1.5" BorderBrush="#242C3D">
                        <Border.Background>
                            <RadialGradientBrush Center="0.5,0.5" GradientOrigin="0.5,0.5" RadiusX="0.5" RadiusY="0.5">
                                <GradientStop Color="#1A1E2B" Offset="0"/>
                                <GradientStop Color="#10131B" Offset="1"/>
                            </RadialGradientBrush>
                        </Border.Background>
                        
                        <!-- Center Logo -->
                        <Image x:Name="imgCenterLogo" 
                               Source="flashwire_gold.png" 
                               Width="76" Height="76" 
                               HorizontalAlignment="Center" 
                               VerticalAlignment="Center"
                               RenderOptions.BitmapScalingMode="HighQuality"/>
                    </Border>
                </Grid>

                <!-- Subtitle Status -->
                <TextBlock x:Name="txtSubStatus" Text="DPI ve DNS kalkanı şu anda devre dışı" 
                           Foreground="#94A3B8" FontSize="11.5" HorizontalAlignment="Center" Margin="0,0,0,20"/>

                <!-- 3. THE ONE BUTTON (TEK TUŞ BAĞLAN) -->
                <Button x:Name="btnConnectToggle" 
                        Style="{StaticResource ActionButtonStyle}"
                        Width="260" Height="50"
                        Click="BtnConnectToggle_Click">
                    <Button.Background>
                        <LinearGradientBrush StartPoint="0,0" EndPoint="1,0">
                            <GradientStop Color="#FFB800" Offset="0"/>
                            <GradientStop Color="#E0A200" Offset="1"/>
                        </LinearGradientBrush>
                    </Button.Background>
                    <Button.Effect>
                        <DropShadowEffect x:Name="btnShadow" Color="#FFB800" BlurRadius="18" ShadowDepth="2" Opacity="0.45"/>
                    </Button.Effect>
                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" VerticalAlignment="Center">
                        <Path x:Name="btnIconPath" Data="M13 2 L3 14 L12 14 L11 22 L21 10 L12 10 Z" Fill="#0B0D12" Stretch="Uniform" Width="14" Height="14" Margin="0,0,10,0"/>
                        <TextBlock x:Name="btnConnectText" Text="BAĞLAN" FontSize="15" FontWeight="ExtraBold" Foreground="#0B0D12"/>
                    </StackPanel>
                </Button>

                <!-- 4. Wide Network Profile Card (Expandable Drawer) -->
                <Border x:Name="panelSettings" Visibility="Visible" Background="#131620" BorderBrush="#242C3D" BorderThickness="1" CornerRadius="14" Margin="0,16,0,0" Padding="14,10" Width="260">
                    <StackPanel>
                        <Grid Margin="0,0,0,6">
                            <TextBlock Text="⚡ Aktif Ağ &amp; Operatör Profili" Foreground="#94A3B8" FontSize="10.5" FontWeight="SemiBold"/>
                        </Grid>
                        <ComboBox x:Name="cmbProfiles" Height="34" Style="{StaticResource DarkComboBoxStyle}" SelectionChanged="CmbProfiles_SelectionChanged">
                            <ComboBoxItem Content="⚡ Otomatik (Tüm Siteler &amp; Discord)" IsSelected="True"/>
                            <ComboBoxItem Content="🔴 Turkcell (Superonline &amp; Mobil)"/>
                            <ComboBoxItem Content="🟣 Vodafone (Fiber &amp; Redbox)"/>
                            <ComboBoxItem Content="🔵 Türk Telekom (TTNet &amp; Mobil)"/>
                            <ComboBoxItem Content="🟡 TurkNet (GigaFiber &amp; VDSL)"/>
                            <ComboBoxItem Content="🟢 Türksat Kablonet"/>
                            <ComboBoxItem Content="🌐 Evrensel Mod (GoodbyeDPI)"/>
                        </ComboBox>
                    </StackPanel>
                </Border>

            </StackPanel>

            <!-- 5. DIAGNOSTIC TEST PANEL DRAWER (Expandable / Collapsible) -->
            <Border Grid.Row="2" x:Name="panelTest" Visibility="Collapsed" Background="#131620" BorderBrush="#242C3D" BorderThickness="1" CornerRadius="16" Margin="18,0,18,10" Padding="14,12">
                <StackPanel>
                    <Grid Margin="0,0,0,10">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="🚀" FontSize="13" Margin="0,0,6,0"/>
                            <TextBlock Text="Ağ &amp; Erişim Teşhisi" Foreground="#F8FAFC" FontWeight="Bold" FontSize="12.5"/>
                        </StackPanel>
                        <Button Style="{StaticResource WindowBtnStyle}" Content="✕" Click="BtnCloseTest_Click" HorizontalAlignment="Right" Width="22" Height="22" FontSize="10"/>
                    </Grid>

                    <!-- Test Items Grid -->
                    <UniformGrid Columns="2" Margin="0,0,0,10">
                        <StackPanel Margin="4,2">
                            <TextBlock Text="Discord" Foreground="#94A3B8" FontSize="10.5"/>
                            <TextBlock x:Name="txtTestDiscord" Text="Bekleniyor..." Foreground="#64748B" FontSize="11" FontWeight="Bold"/>
                        </StackPanel>
                        <StackPanel Margin="4,2">
                            <TextBlock Text="Roblox" Foreground="#94A3B8" FontSize="10.5"/>
                            <TextBlock x:Name="txtTestRoblox" Text="Bekleniyor..." Foreground="#64748B" FontSize="11" FontWeight="Bold"/>
                        </StackPanel>
                        <StackPanel Margin="4,2">
                            <TextBlock Text="Wattpad" Foreground="#94A3B8" FontSize="10.5"/>
                            <TextBlock x:Name="txtTestWattpad" Text="Bekleniyor..." Foreground="#64748B" FontSize="11" FontWeight="Bold"/>
                        </StackPanel>
                        <StackPanel Margin="4,2">
                            <TextBlock Text="Ekşi Sözlük" Foreground="#94A3B8" FontSize="10.5"/>
                            <TextBlock x:Name="txtTestEksi" Text="Bekleniyor..." Foreground="#64748B" FontSize="11" FontWeight="Bold"/>
                        </StackPanel>
                        <StackPanel Margin="4,2">
                            <TextBlock Text="Instagram" Foreground="#94A3B8" FontSize="10.5"/>
                            <TextBlock x:Name="txtTestInstagram" Text="Bekleniyor..." Foreground="#64748B" FontSize="11" FontWeight="Bold"/>
                        </StackPanel>
                        <StackPanel Margin="4,2">
                            <TextBlock Text="YouTube" Foreground="#94A3B8" FontSize="10.5"/>
                            <TextBlock x:Name="txtTestYoutube" Text="Bekleniyor..." Foreground="#64748B" FontSize="11" FontWeight="Bold"/>
                        </StackPanel>
                    </UniformGrid>

                    <Button x:Name="btnStartTest" Content="Testi Başlat" Click="BtnStartTest_Click" Height="28" Background="#1C2333" Foreground="#FFB800" FontWeight="Bold" FontSize="11.5" Cursor="Hand">
                        <Button.Template>
                            <ControlTemplate TargetType="Button">
                                <Border Background="{TemplateBinding Background}" CornerRadius="14" BorderBrush="#2E384D" BorderThickness="1">
                                    <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                </Border>
                            </ControlTemplate>
                        </Button.Template>
                    </Button>
                </StackPanel>
            </Border>

            <!-- BOTTOM FOOTER BAR -->
            <Border Grid.Row="3" Background="#080A0E" CornerRadius="0,0,24,24" Padding="18,10" BorderBrush="#161C26" BorderThickness="0,1,0,0">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    
                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                        <TextBlock Text="🛡️" FontSize="11" Margin="0,0,5,0"/>
                        <TextBlock x:Name="txtFooterEngine" Text="AdGuard DNS • WinDivert x64" Foreground="#94A3B8" FontSize="10.5"/>
                    </StackPanel>

                    <TextBlock Grid.Column="1" Text="FlashWire v2.0" Foreground="#64748B" FontSize="10" FontWeight="SemiBold" VerticalAlignment="Center"/>
                </Grid>
            </Border>
        </Grid>
    </Border>
</Window>