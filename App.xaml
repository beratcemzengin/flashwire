<Application x:Class="FlashWire.App"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             StartupUri="MainWindow.xaml">
    <Application.Resources>
        <!-- Modern Dark Theme Brushes -->
        <SolidColorBrush x:Key="BgDark" Color="#0e1118"/>
        <SolidColorBrush x:Key="CardDark" Color="#161b26"/>
        <SolidColorBrush x:Key="CardBorder" Color="#222938"/>
        <SolidColorBrush x:Key="TextPrimary" Color="#f3f4f6"/>
        <SolidColorBrush x:Key="TextSecondary" Color="#9ca3af"/>
        <SolidColorBrush x:Key="TextMuted" Color="#6b7280"/>
        
        <!-- Status Colors -->
        <SolidColorBrush x:Key="ColorGreen" Color="#10b981"/>
        <SolidColorBrush x:Key="ColorGreenGlow" Color="#34d399"/>
        <SolidColorBrush x:Key="ColorRed" Color="#ef4444"/>
        <SolidColorBrush x:Key="ColorRedGlow" Color="#f87171"/>
        <SolidColorBrush x:Key="ColorAmber" Color="#f59e0b"/>
    </Application.Resources>
</Application>
